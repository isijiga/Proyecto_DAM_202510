<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/borde"
            android:padding="10dp"
            android:src="@drawable/entrega_inv"
            app:tint="#3F51B5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_item_numero"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="19"
            android:textSize="14sp"

            android:textColor="#212121"
            app:layout_constraintStart_toEndOf="@+id/imgAvatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/imgAvatar"/>

        <TextView
            android:id="@+id/tv_item_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13/12/2025"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="#9E9E9E"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="13 dic" />

        <TextView
            android:id="@+id/tv_item_nombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="Hugo Duro (19Val)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121"
            app:layout_constraintStart_toEndOf="@+id/tv_item_numero"
            app:layout_constraintEnd_toStartOf="@+id/tv_item_fecha"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_item_pedidoA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="usuario@usuario.com"
            android:textSize="14sp"
            android:textColor="#555555"
            app:layout_constraintStart_toStartOf="@+id/tv_item_nombre"
            app:layout_constraintEnd_toStartOf="@+id/message"
            app:layout_constraintTop_toBottomOf="@+id/tv_item_nombre"


            />

        <ImageView
            android:id="@+id/message"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/message"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tv_item_pedidoA"
            app:layout_constraintTop_toTopOf="@+id/tv_item_pedidoA"
            app:layout_constraintBottom_toBottomOf="@+id/tv_item_pedidoA"
            />
        <View
            android:id="@+id/dividerMeta"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#F0F0F0"
            app:layout_constraintTop_toBottomOf="@+id/tv_item_pedidoA"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_item_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/carta_intercambio_fondo"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="8dp"
            android:text="PENDIENTE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#F57F17"
            android:textAllCaps="true"
            app:layout_constraintTop_toBottomOf="@id/dividerMeta"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="PENDIENTE" />

        <ImageView
            android:id="@+id/EstadoIco"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/arrowizq"
            app:tint="@color/back"
            app:layout_constraintEnd_toStartOf="@id/tv_item_estado"
            app:layout_constraintTop_toTopOf="@id/tv_item_estado"
            app:layout_constraintBottom_toBottomOf="@id/tv_item_estado"/>

        <TextView
            android:id="@+id/tv_item_coleccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Laliga 2025-26"
            android:textSize="12sp"
            android:textColor="#757575"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="@id/imgAvatar"
            app:layout_constraintEnd_toStartOf="@+id/EstadoIco"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_item_estado"
            tools:text="Laliga 2025-26 C.Este" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>