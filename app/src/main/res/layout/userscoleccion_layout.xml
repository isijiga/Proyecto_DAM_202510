<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <ImageView
            android:id="@+id/iv_coleccion_imagen"
            android:layout_width="90dp"
            android:layout_height="120dp"
            android:padding="4dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
             />


        <LinearLayout
            android:id="@+id/linearLayout_texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/iv_coleccion_imagen"
            app:layout_constraintEnd_toStartOf="@id/iv_coleccion_flecha"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">


            <TextView
                android:id="@+id/tv_coleccion_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nueva Coleccion"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tv_coleccion_subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="coleccion Nueva Temporada"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <ProgressBar
                android:id="@+id/tvColeccionProgreso"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:progress="30"
                android:progressBackgroundTint="#9575CD"
                android:progressTint="@android:color/black"

                />

            <TextView
                android:id="@+id/tv_coleccion_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:text="01/01/2025"/>

        </LinearLayout>


        <ImageView
            android:id="@+id/iv_coleccion_flecha"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:src="@drawable/arrow_right"

             />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
