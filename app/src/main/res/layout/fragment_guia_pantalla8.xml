<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Guia.GuiaPantalla8Fragment"
    android:background="@drawable/fondo_degradado">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/pantalla8"
        android:scaleType="fitXY"

        />

    <TextView
        android:id="@+id/texto_guia"
        style="@style/Guia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"



        android:text="Desde el apartado de Perfil,
        podrás gestionar tu cuenta: tienes la opción de cambiar
         la contraseña de usuario o cerrar sesión.
          ¡La Guía ha finalizado!
         Regístrate para acceder."
        />

</FrameLayout>