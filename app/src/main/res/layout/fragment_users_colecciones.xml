<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"  tools:context=".Dash.UsersColeccionesFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewUsersColecciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"       android:layout_weight="1"         android:padding="4dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/userscoleccion_layout" />

    <Button
        android:id="@+id/bt_Agregar_Coleccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="Agregar Coleccion" />

</LinearLayout>