<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Dash.Fragments.DetalleColeccionFragment">


        <ImageButton
            android:id="@+id/btn_atras_manual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:padding="8dp"
            app:layout_constraintBottom_toTopOf="@id/rv_detalle_items"
            app:layout_constraintEnd_toStartOf="@+id/cardView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/arrow_back"
            app:tint="@android:color/white" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginEnd="8dp"
            android:layout_marginVertical="8dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#6A359C"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toTopOf="@+id/rv_detalle_items"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_atras_manual"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/iv_portada"
                    android:layout_width="80dp"
                    android:layout_height="100dp"
                    android:layout_marginVertical="12dp"
                    android:layout_marginEnd="12dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:srcCompat="@tools:sample/backgrounds/scenic" />

                <TextView
                    android:id="@+id/tv_progress"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@android:color/white"
                    android:textSize="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/tvColeccionProgreso"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.4" />

                <TextView
                    android:id="@+id/tvColeccionTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="SuperCracks 2023-2024"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/tv_subhead"
                    app:layout_constraintEnd_toStartOf="@+id/iv_portada"
                    app:layout_constraintStart_toEndOf="@+id/tv_progress"
                    app:layout_constraintTop_toTopOf="@+id/tv_progress" />

                <TextView
                    android:id="@+id/tv_subhead"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_progress"
                    app:layout_constraintEnd_toEndOf="@+id/tvColeccionTitulo"
                    app:layout_constraintStart_toStartOf="@+id/tvColeccionTitulo"
                    app:layout_constraintTop_toBottomOf="@+id/tvColeccionTitulo" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/tvColeccionProgreso"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="16dp"
                    android:progress="30"
                    app:trackThickness="8dp"
                    app:indicatorInset="0dp"
                    android:progressBackgroundTint="#9575CD"
                    android:progressTint="@android:color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_portada"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_detalle_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView"
        tools:listitem="@layout/cromoposesion_layout" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_agregar_cromo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:contentDescription="Añadir cromo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/add_circle"

        />


</androidx.constraintlayout.widget.ConstraintLayout>