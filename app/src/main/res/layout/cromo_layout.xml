<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <ImageView
            android:id="@+id/iv_cromo_imagen"
            android:layout_width="80dp"
            android:layout_height="100dp"
            android:padding="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:srcCompat="@tools:sample/avatars" />

        <ImageView
            android:id="@+id/loTengo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:layout_constraintEnd_toEndOf="@id/iv_cromo_imagen"
            app:layout_constraintBottom_toBottomOf="@id/iv_cromo_imagen"
            android:layout_marginBottom="7dp"
            android:src="@drawable/check"
            android:rotation="-10"
            android:visibility="gone"
            ></ImageView>


        <LinearLayout
            android:id="@+id/linearLayout_texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/iv_cromo_imagen"
            app:layout_constraintEnd_toStartOf="@id/iv_cromo_flecha"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:id="@+id/tv_cromo_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="101ALA"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cromo_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuevo Cromo"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tv_carta_subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="coleccion Nueva Temporada"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>


            <TextView
                android:id="@+id/tv_carta_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp" />

        </LinearLayout>


        <ImageView
            android:id="@+id/iv_cromo_flecha"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"

             />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
